# Copy to .env (git ignores it) and fill in. Treat every value here like a password.
# Use SINGLE quotes around values that contain $ (password hashes).

# Public address of this PC (from Tailscale Funnel / Cloudflare Tunnel)
KALENDS_BASE_URL=https://your-pc.your-tailnet.ts.net
# Run: kalends new-secret
KALENDS_SECRET_KEY=

# Settings-panel password. Run: kalends admin-password
KALENDS_ADMIN_PASSWORD_HASH=''

# Calendar feed links (see README: "Getting your feed links")
GOOGLE_PERSONAL_ICS=
OUTLOOK_LAB_ICS=
OUTLOOK_CLASSES_ICS=
ICLOUD_FAMILY_ICS=

# Audience links. Run: kalends new-slug   (once per audience)
PARTNER_SLUG=
COWORKER_SLUG=

# Run: kalends hash-password
PARTNER_PW_HASH=''

# Optional (0.5): the panel creates these for you when you switch the features on.
# Website widget link. Run: kalends new-slug
KALENDS_AUD_COWORKERS_WIDGET_SLUG=
# Phone notifications: a long, unguessable ntfy topic
KALENDS_NTFY_TOPIC=
# Email notifications: your SMTP (app) password
KALENDS_SMTP_PASSWORD=''
# Discord notifications: the channel's webhook link
KALENDS_DISCORD_WEBHOOK=

# Optional (0.7+): video calls. Client secrets for Zoom, Google Meet and Webex (the panel saves them here).
KALENDS_ZOOM_CLIENT_SECRET=
KALENDS_GOOGLE_CLIENT_SECRET=
KALENDS_WEBEX_CLIENT_SECRET=

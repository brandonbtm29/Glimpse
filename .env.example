# Copy to .env (git ignores it) and fill in. Treat every value here like a password.
# Use SINGLE quotes around values that contain $ (password hashes).

# Public address of this PC (from Tailscale Funnel / Cloudflare Tunnel)
GLIMPSE_BASE_URL=https://your-pc.your-tailnet.ts.net
# Run: glimpse new-secret
GLIMPSE_SECRET_KEY=

# Calendar feed links (see README: "Getting your feed links")
GOOGLE_PERSONAL_ICS=
OUTLOOK_LAB_ICS=
OUTLOOK_CLASSES_ICS=
ICLOUD_FAMILY_ICS=

# Audience links. Run: glimpse new-slug   (once per audience)
PARTNER_SLUG=
COWORKER_SLUG=

# Run: glimpse hash-password
PARTNER_PW_HASH=''
